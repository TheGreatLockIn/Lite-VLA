{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lite-vla.local/config/schema.json",
  "title": "LiteVLAConfig",
  "description": "Runtime, model, ROS, safety, benchmark, and training settings for Lite-VLA.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "model", "ros", "safety", "benchmark"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "heartbeat_hz", "default_instruction"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dummy", "teleop", "model"],
          "description": "dummy/teleop use scripted or keyboard actions; model runs VLM inference."
        },
        "heartbeat_hz": {
          "type": "number",
          "minimum": 0.1,
          "description": "Command publish rate in Hz."
        },
        "default_instruction": {
          "type": "string",
          "minLength": 1,
          "description": "Goal text sent with each frame when no override is provided."
        },
        "sequence_step_sec": {
          "type": "number",
          "minimum": 0.1,
          "description": "Seconds between scripted dummy actions."
        },
        "action_sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "MOVE_FORWARD",
              "TURN_LEFT",
              "TURN_RIGHT",
              "SLOW_DOWN",
              "STOP"
            ]
          },
          "description": "Ordered dummy actions before ML is connected."
        },
        "action_timeout_sec": {
          "type": "number",
          "minimum": 0.05,
          "description": "Seconds without a fresh action before STOP."
        },
        "frame_timeout_sec": {
          "type": "number",
          "minimum": 0.1,
          "description": "Seconds without a camera frame before STOP."
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "max_tokens", "context_length", "prompt_version"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Local path or Hugging Face model id."
        },
        "device": {
          "type": "string",
          "enum": ["cpu", "cuda", "mps"],
          "description": "Torch device for inference and training."
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum tokens generated per model call."
        },
        "context_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum context window for the runtime."
        },
        "prompt_version": {
          "type": "string",
          "enum": ["v1", "v2"],
          "description": "Version of the navigation prompt template to load."
        }
      }
    },
    "ros": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_topic",
        "cmd_vel_topic",
        "diagnostics_topic",
        "record_frames",
        "frame_save_dir"
      ],
      "properties": {
        "image_topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Camera image subscription topic."
        },
        "cmd_vel_topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Velocity command publication topic."
        },
        "diagnostics_topic": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Diagnostics and status publication topic."
        },
        "record_frames": {
          "type": "boolean",
          "description": "When true, save incoming frames to frame_save_dir."
        },
        "frame_save_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory for optional frame recording."
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_linear_vel", "max_angular_vel"],
      "properties": {
        "max_linear_vel": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum absolute linear velocity (m/s)."
        },
        "max_angular_vel": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum absolute angular velocity (rad/s)."
        }
      }
    },
    "smoothing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, rate-limit velocity changes between inference steps."
        },
        "max_linear_rate": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum linear velocity change (m/s per second)."
        },
        "max_angular_rate": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum angular velocity change (rad/s per second)."
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "warmup"],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Timed inference iterations per benchmark run."
        },
        "warmup": {
          "type": "integer",
          "minimum": 0,
          "description": "Untimed warm-up iterations before measurement."
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_path": {
          "type": "string",
          "minLength": 1,
          "description": "JSON Schema path for training JSONL records."
        },
        "processed_version": {
          "type": "string",
          "minLength": 1,
          "description": "Dataset version directory under data/processed/."
        },
        "train_path": {
          "type": "string",
          "minLength": 1,
          "description": "Training split JSONL path."
        },
        "val_path": {
          "type": "string",
          "minLength": 1,
          "description": "Validation split JSONL path."
        },
        "raw_episodes_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Root directory for raw simulation capture episodes."
        },
        "default_instruction": {
          "type": "string",
          "minLength": 1,
          "description": "Default instruction text when an episode omits one."
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Random seed for reproducible training runs."
        },
        "lora_rank": {
          "type": "integer",
          "minimum": 1,
          "description": "LoRA adapter rank."
        },
        "lora_alpha": {
          "type": "number",
          "minimum": 0,
          "description": "LoRA scaling factor (alpha)."
        },
        "lora_dropout": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "LoRA dropout probability."
        },
        "dataset_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to training dataset."
        },
        "output_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Directory for checkpoints and run artifacts."
        }
      }
    }
  }
}
